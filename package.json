{
  "name": "discord-bot-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Base modular de un bot de Discord en TypeScript",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "deploy:commands:prod": "node dist/deploy-commands.js",
    "build:admin": "astro build --root admin-panel"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "^16.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^1.66.0",
    "morphicons": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3"
  }
}
