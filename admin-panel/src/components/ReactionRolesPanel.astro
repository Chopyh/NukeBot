<section aria-labelledby="reaction-roles-title">
  <div class="section-head">
    <div><h2 id="reaction-roles-title" class="section-title">Crear mensaje de roles</h2><p class="section-note">Diseña el mensaje, elige un canal y añade una opción por cada rol que quieras ofrecer.</p></div>
  </div>
  <form id="reaction-role-form" class="settings-form reaction-role-form">
    <div class="reaction-role-editor-grid">
      <div class="reaction-role-fields">
        <label class="field">Servidor<select id="reaction-role-guild" required><option value="">Cargando servidores…</option></select></label>
        <label class="field">Canal de publicación<select id="reaction-role-channel" required disabled><option value="">Selecciona un servidor</option></select></label>
        <label class="field">Título del mensaje<input id="reaction-role-title-input" maxlength="256" placeholder="Elige tus roles" /></label>
        <label class="field">Color del mensaje<div class="reaction-role-color"><input id="reaction-role-color" type="color" value="#5865F2" /><output id="reaction-role-color-value">#5865F2</output></div></label>
        <label class="field reaction-role-description-field">Descripción del mensaje
          <div class="rich-toolbar" role="toolbar" aria-label="Formato de texto">
            <button type="button" data-format="bold" aria-label="Negrita"><strong>B</strong></button><button type="button" data-format="italic" aria-label="Cursiva"><em>I</em></button><button type="button" data-format="underline" aria-label="Subrayado"><u>U</u></button><button type="button" data-format="strike" aria-label="Tachado"><s>S</s></button><button type="button" data-format="code" aria-label="Código">&lt;/&gt;</button><button type="button" data-format="quote" aria-label="Cita">❞</button>
          </div>
          <textarea id="reaction-role-description" maxlength="4096" rows="7" placeholder="Reacciona debajo para elegir tus roles. Puedes usar formato de Discord con la barra de herramientas."></textarea>
          <span class="field-hint">Admite formato de Discord. Máximo 4096 caracteres.</span>
        </label>
      </div>
      <aside class="embed-preview" aria-label="Vista previa del mensaje">
        <div class="embed-preview-label">VISTA PREVIA EN DISCORD</div>
        <div class="embed-preview-card"><div id="reaction-role-preview-bar" class="embed-preview-bar"></div><div class="embed-preview-content"><strong id="reaction-role-preview-title">Elige tus roles</strong><div id="reaction-role-preview-description">Reacciona debajo para elegir tus roles. Puedes usar formato de Discord con la barra de herramientas.</div></div></div>
      </aside>
    </div>
    <div class="reaction-role-options-heading"><div><h3 class="section-title">Opciones de roles</h3><p class="section-note">Cada emoji asigna el rol que el miembro seleccione.</p></div><button id="reaction-role-add-option" class="button" type="button">＋ Añadir opción</button></div>
    <div id="reaction-role-options" class="reaction-role-options"></div>
    <div class="reaction-role-form-footer"><button id="reaction-role-save" class="button primary" type="submit">Publicar mensaje</button><p id="reaction-role-form-message" class="message" role="status" aria-live="polite"></p></div>
  </form>

  <section class="section" aria-labelledby="reaction-role-list-title">
    <div class="section-head">
      <div><h2 id="reaction-role-list-title" class="section-title">Asociaciones activas</h2><p class="section-note">Configuradas desde este panel.</p></div>
      <button id="refresh-reaction-roles" class="button" type="button">Actualizar</button>
    </div>
    <div class="table-wrap">
      <table class="flat-table reaction-role-table">
        <thead><tr><th scope="col">Servidor</th><th scope="col">Emoji</th><th scope="col">Rol</th><th scope="col">Canal</th><th scope="col">Mensaje</th><th scope="col">Acciones</th></tr></thead>
        <tbody id="reaction-role-rows"></tbody>
      </table>
    </div>
    <p id="reaction-role-list-message" class="message" role="status" aria-live="polite">Cargando asociaciones…</p>
  </section>
</section>
