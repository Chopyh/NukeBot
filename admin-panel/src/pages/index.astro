<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Administración · Nuke Bot</title>
  <style>
    :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #e8e8e9; background: #101113; font-synthesis: none; --bg: #101113; --panel: #151618; --line: #292a2d; --muted: #85868b; --soft: #b9babd; --accent: #d3ff75; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; }
    button, input, select { font: inherit; }
    button { cursor: pointer; }
    .layout { min-height: 100vh; }
    .sidebar { position: fixed; inset: 0 auto 0 0; display: flex; width: 236px; flex-direction: column; padding: 22px 14px 16px; border-right: 1px solid var(--line); background: #121315; }
    .brand { display: flex; align-items: center; gap: 11px; padding: 0 9px 26px; color: #f0f0f0; font-size: 13px; font-weight: 750; letter-spacing: .09em; }
    .brand-mark { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid #44464a; border-radius: 8px; color: var(--accent); font-weight: 800; }
    .brand small { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; font-weight: 500; letter-spacing: .04em; }
    .nav-label { margin: 17px 10px 7px; color: #68696e; font-size: 10px; font-weight: 700; letter-spacing: .12em; }
    .nav-link { display: flex; width: 100%; align-items: center; gap: 11px; margin: 2px 0; padding: 10px 11px; border: 0; border-radius: 6px; color: #a7a8ab; background: transparent; text-align: left; font-size: 13px; }
    .nav-link:hover { color: #efeff0; background: #1b1c1f; }
    .nav-link.active { color: #e9f3d4; background: #20231c; }
    .nav-icon { width: 16px; color: #77797e; text-align: center; font-size: 14px; }
    .nav-link.active .nav-icon { color: var(--accent); }
    .sidebar-bottom { margin-top: auto; padding: 14px 10px 0; border-top: 1px solid var(--line); color: #77797e; font-size: 11px; }
    .sidebar-bottom span { display: flex; align-items: center; gap: 8px; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #707176; }
    .status-dot.online { background: var(--accent); }
    .status-dot.offline { background: #e06b6b; }
    .main { min-height: 100vh; margin-left: 236px; }
    .topbar { position: sticky; z-index: 2; top: 0; display: flex; min-height: 63px; align-items: center; justify-content: space-between; padding: 0 36px; border-bottom: 1px solid var(--line); background: #101113; }
    .crumb { color: var(--muted); font-size: 12px; }
    .top-actions { display: flex; align-items: center; gap: 15px; }
    .session-name { color: #96979b; font-size: 12px; }
    .logout { padding: 7px 10px; border: 1px solid var(--line); border-radius: 5px; color: #bdbec1; background: transparent; font-size: 11px; }
    .logout:hover { border-color: #535459; color: white; }
    .content { width: min(100%, 1120px); margin: 0 auto; padding: 36px; }
    .page { display: none; }
    .page.active { display: block; }
    .page-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 29px; }
    h1 { margin: 0; color: #f0f0f1; font-size: 24px; font-weight: 620; letter-spacing: -.035em; }
    .subtitle { margin: 7px 0 0; color: var(--muted); font-size: 12px; }
    .section-title { margin: 0; color: #e7e7e8; font-size: 14px; font-weight: 620; }
    .section-note { margin: 5px 0 0; color: var(--muted); font-size: 11px; line-height: 1.5; }
    .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .stat { padding: 18px 20px 17px 0; }
    .stat + .stat { padding-left: 20px; border-left: 1px solid var(--line); }
    .stat-label { color: var(--muted); font-size: 11px; }
    .stat-value { margin-top: 9px; color: #ededee; font-size: 21px; font-weight: 600; letter-spacing: -.03em; }
    .stat-detail { margin-top: 4px; color: #6f7075; font-size: 10px; }
    .section { margin-top: 30px; }
    .section-head { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 14px; }
    .flat-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 11px; }
    .flat-table th { padding: 10px 12px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: #85868b; font-size: 10px; font-weight: 600; }
    .flat-table td { padding: 12px; border-bottom: 1px solid #222326; color: #c6c7ca; vertical-align: middle; }
    .flat-table code { color: #929398; font-size: 10px; }
    .table-wrap { overflow-x: auto; }
    .empty { padding: 20px 12px; color: #797a7f; font-size: 11px; }
    .toolbar { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; }
    .field { display: grid; min-width: 0; flex: 1; gap: 7px; color: #a5a6aa; font-size: 11px; }
    .field.small { max-width: 205px; flex: 1 1 165px; }
    .field.wide { flex: 2 1 250px; }
    input, select { width: 100%; min-height: 36px; padding: 0 10px; border: 1px solid #35363a; border-radius: 5px; outline: none; color: #e6e6e7; background: #111214; font-size: 12px; }
    input:focus, select:focus { border-color: #919b72; }
    select option { background: #17181a; }
    .button { min-height: 36px; padding: 0 13px; border: 1px solid #3b3c40; border-radius: 5px; color: #d5d5d7; background: #1a1b1e; font-size: 11px; }
    .button:hover { border-color: #5b5d62; color: white; }
    .button.primary { border-color: var(--accent); color: #171a10; background: var(--accent); font-weight: 700; }
    .button.primary:hover { background: #c2ef64; }
    .button.danger { border-color: #583436; color: #f0a0a2; background: #211719; }
    .button:disabled { cursor: not-allowed; opacity: .45; }
    .divider { height: 1px; margin: 23px 0; border: 0; background: var(--line); }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 680px; margin-top: 22px; }
    .message { min-height: 17px; margin: 11px 0 0; color: #8e8f94; font-size: 11px; }
    .message.error { color: #ee9b9d; }
    .message.success { color: #c9ed83; }
    .member-results { max-width: 520px; }
    .member-summary { display: flex; align-items: center; gap: 10px; min-height: 38px; color: #c9cace; font-size: 11px; }
    .member-avatar { width: 28px; height: 28px; border-radius: 50%; background: #28292d; }
    .test-list { margin-top: 14px; border-top: 1px solid var(--line); }
    .test-row { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 13px 0; border-bottom: 1px solid #222326; }
    .test-user { color: #d8d8da; font-size: 12px; }
    .test-detail { margin-top: 4px; color: #85868b; font-size: 10px; }
    .settings-form { max-width: 650px; }
    .settings-form .field { margin-bottom: 16px; }
    footer { margin-top: 38px; color: #626368; font-size: 10px; }
    @media (max-width: 760px) {
      .sidebar { position: static; width: 100%; height: auto; padding: 12px; border-right: 0; border-bottom: 1px solid var(--line); }
      .brand { padding: 0 6px 10px; }
      .nav-label, .sidebar-bottom { display: none; }
      .nav-group { display: flex; gap: 4px; }
      .nav-link { width: auto; padding: 9px; }
      .nav-link .nav-icon { display: none; }
      .main { margin-left: 0; }
      .topbar { min-height: 52px; padding: 0 16px; }
      .content { padding: 25px 16px; }
      .stats { grid-template-columns: 1fr; }
      .stat, .stat + .stat { padding: 13px 0; border-left: 0; border-bottom: 1px solid #222326; }
      .stat:last-child { border-bottom: 0; }
      .form-row { grid-template-columns: 1fr; }
      .field.small { max-width: none; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand"><div class="brand-mark">N</div><div>NUKE BOT<small>ADMINISTRACIÓN</small></div></div>
      <div class="nav-label">GENERAL</div>
      <nav class="nav-group" aria-label="Navegación principal">
        <button class="nav-link active" data-page="overview"><span class="nav-icon">⌂</span>Resumen</button>
      </nav>
      <div class="nav-label">COMUNIDAD</div>
      <nav class="nav-group" aria-label="Comunidad">
        <button class="nav-link" data-page="birthdays"><span class="nav-icon">◷</span>Cumpleaños</button>
      </nav>
      <div class="nav-label">SISTEMA</div>
      <nav class="nav-group" aria-label="Sistema">
        <button class="nav-link" data-page="settings"><span class="nav-icon">⚙</span>Configuración</button>
      </nav>
      <div class="sidebar-bottom"><span><i id="sidebar-dot" class="status-dot"></i><span id="sidebar-status">Comprobando conexión</span></span></div>
    </aside>

    <div class="main">
      <header class="topbar"><div class="crumb">Nuke Bot <span style="color:#55565a">/</span> <span id="current-section">Resumen</span></div><div class="top-actions"><span class="session-name">Sesión de administrador</span><button id="logout" class="logout">Cerrar sesión</button></div></header>
      <main class="content">
        <section id="page-overview" class="page active">
          <div class="page-heading"><div><h1>Resumen</h1><p class="subtitle">Estado del bot y actividad del servidor.</p></div></div>
          <div class="stats" aria-live="polite">
            <div class="stat"><div class="stat-label">Conexión</div><div id="status" class="stat-value">Comprobando</div><div id="bot-name" class="stat-detail">Esperando al bot</div></div>
            <div class="stat"><div class="stat-label">Servidores de Discord</div><div id="guilds" class="stat-value">—</div><div class="stat-detail">Servidores conectados</div></div>
            <div class="stat"><div class="stat-label">Tiempo activo</div><div id="uptime" class="stat-value">—</div><div class="stat-detail">Desde el último inicio</div></div>
          </div>
          <section class="section"><div class="section-head"><div><h2 class="section-title">Cumpleaños registrados</h2><p class="section-note">Vista rápida de los registros guardados.</p></div><button class="button" data-open-page="birthdays">Ver todos</button></div><div id="overview-birthdays" class="empty">Cargando registros…</div></section>
          <footer>Panel privado · Actualización del estado cada 15 segundos</footer>
        </section>

        <section id="page-birthdays" class="page">
          <div class="page-heading"><div><h1>Cumpleaños</h1><p class="subtitle">Registros y pruebas temporales de la decoración y el rol.</p></div><button id="refresh-birthdays" class="button">Actualizar</button></div>
          <section>
            <div class="section-head"><div><h2 class="section-title">Registros</h2><p class="section-note">Fechas, emojis y roles elegidos por los usuarios.</p></div><span id="birthday-count" class="section-note"></span></div>
            <div class="table-wrap"><table class="flat-table"><thead><tr><th>Servidor</th><th>Usuario</th><th>Fecha</th><th>Emoji</th><th>Rol</th><th>Estado</th></tr></thead><tbody id="birthday-rows"></tbody></table></div>
            <p id="birthday-message" class="message" role="status">Cargando cumpleaños…</p>
          </section>

          <hr class="divider">
          <section>
            <div class="section-head"><div><h2 class="section-title">Prueba de cumpleaños</h2><p class="section-note">Aplica el emoji a los canales y asigna el rol durante un máximo de 10 minutos.</p></div></div>
            <div class="toolbar">
              <label class="field small">Servidor<select id="test-guild"><option value="">Cargando servidores…</option></select></label>
              <label class="field wide">Buscar usuario<input id="member-query" type="search" placeholder="Nombre, apodo o usuario…" autocomplete="off"></label>
            </div>
            <div class="form-row">
              <label class="field">Resultados<select id="member-results" size="4" class="member-results" aria-label="Resultados de búsqueda de miembros"><option value="">Escribe para buscar miembros</option></select></label>
              <div><div class="field">Usuario seleccionado</div><div id="selected-member" class="member-summary">Ningún usuario seleccionado</div></div>
            </div>
            <div class="form-row">
              <label class="field">Emoji de prueba<input id="test-emoji" maxlength="64" value="🎂"></label>
              <label class="field">Nombre del rol temporal<input id="test-role" maxlength="100" placeholder="Cumpleañero"></label>
            </div>
            <div class="actions" style="display:flex;align-items:center;gap:12px;margin-top:16px"><button id="start-test" class="button primary" disabled>Iniciar prueba</button><span id="test-message" class="message" role="status"></span></div>
            <div class="section" style="margin-top:34px"><div class="section-head"><div><h2 class="section-title">Pruebas activas</h2><p class="section-note">Cancelar elimina el rol y restaura los nombres de canales inmediatamente.</p></div></div><div id="active-tests" class="test-list"><p class="empty">Cargando pruebas…</p></div></div>
          </section>
        </section>

        <section id="page-settings" class="page">
          <div class="page-heading"><div><h1>Configuración</h1><p class="subtitle">Presencia y actividad que muestra el bot en Discord.</p></div></div>
          <form id="settings-form" class="settings-form">
            <label class="field">Texto de actividad <input id="activity-text" maxlength="128" placeholder="Ej. gestionando la comunidad"></label>
            <label class="field">Tipo de actividad<select id="activity-type"><option value="playing">Jugando a</option><option value="listening">Escuchando</option><option value="watching">Viendo</option><option value="competing">Compitiendo en</option></select></label>
            <label class="field">Estado de presencia<select id="presence-status"><option value="online">En línea</option><option value="idle">Ausente</option><option value="dnd">No molestar</option><option value="invisible">Invisible</option></select></label>
            <button id="save-button" class="button primary" type="submit">Guardar cambios</button><p id="save-message" class="message" role="status"></p>
          </form>
        </section>
      </main>
    </div>
  </div>

  <script>
    const statusEl = document.querySelector('#status');
    const birthdayCache = [];
    let selectedMember = null;
    let searchTimer;
    const pageNames = { overview: 'Resumen', birthdays: 'Cumpleaños', settings: 'Configuración' };
    const formatDuration = (seconds) => {
      const days = Math.floor(seconds / 86400); seconds %= 86400;
      const hours = Math.floor(seconds / 3600); seconds %= 3600;
      const minutes = Math.floor(seconds / 60);
      return [days && `${days} d`, hours && `${hours} h`, `${minutes} min`].filter(Boolean).join(' ');
    };
    async function api(path, options = {}) {
      const response = await fetch(path, { cache: 'no-store', ...options, headers: { ...(options.body ? { 'content-type': 'application/json' } : {}), ...(options.headers ?? {}) } });
      const data = await response.json().catch(() => ({}));
      if (response.status === 401) { location.href = '/login'; throw new Error('La sesión expiró.'); }
      if (!response.ok) throw new Error(data.error ?? 'No se pudo completar la solicitud.');
      return data;
    }
    function openPage(name) {
      document.querySelectorAll('.page').forEach((page) => page.classList.toggle('active', page.id === `page-${name}`));
      document.querySelectorAll('.nav-link').forEach((link) => link.classList.toggle('active', link.dataset.page === name));
      document.querySelector('#current-section').textContent = pageNames[name];
      history.replaceState(null, '', `#${name}`);
    }
    document.querySelectorAll('.nav-link').forEach((link) => link.addEventListener('click', () => openPage(link.dataset.page)));
    document.querySelectorAll('[data-open-page]').forEach((button) => button.addEventListener('click', () => openPage(button.dataset.openPage)));
    const initialPage = location.hash.slice(1);
    if (pageNames[initialPage]) openPage(initialPage);

    async function refreshStatus() {
      try {
        const data = await api('/api/status');
        const online = data.status === 'online';
        statusEl.textContent = online ? 'En línea' : data.status === 'starting' ? 'Iniciando' : 'Sin conexión';
        document.querySelector('#bot-name').textContent = data.botName ?? 'El bot todavía no está conectado';
        document.querySelector('#guilds').textContent = data.guilds ?? '—';
        document.querySelector('#uptime').textContent = Number.isFinite(data.uptimeSeconds) ? formatDuration(data.uptimeSeconds) : '—';
        document.querySelector('#sidebar-dot').className = `status-dot ${online ? 'online' : 'offline'}`;
        document.querySelector('#sidebar-status').textContent = online ? 'Bot conectado' : 'Bot desconectado';
      } catch {
        statusEl.textContent = 'Sin conexión';
        document.querySelector('#sidebar-dot').className = 'status-dot offline';
        document.querySelector('#sidebar-status').textContent = 'Bot desconectado';
      }
    }
    async function loadSettings() {
      const { settings } = await api('/api/settings');
      document.querySelector('#activity-text').value = settings.activityText;
      document.querySelector('#activity-type').value = settings.activityType;
      document.querySelector('#presence-status').value = settings.presenceStatus;
    }
    function addCell(row, value, code = false) {
      const cell = document.createElement('td');
      if (code) { const element = document.createElement('code'); element.textContent = value; cell.append(element); }
      else cell.textContent = value;
      row.append(cell);
    }
    async function loadBirthdays() {
      const message = document.querySelector('#birthday-message');
      const rows = document.querySelector('#birthday-rows');
      message.textContent = 'Cargando registros…';
      message.className = 'message';
      rows.replaceChildren();
      try {
        const { birthdays } = await api('/api/birthdays');
        birthdayCache.splice(0, birthdayCache.length, ...birthdays);
        for (const birthday of birthdays) {
          const row = document.createElement('tr');
          addCell(row, birthday.guild_id, true);
          addCell(row, birthday.user_id, true);
          addCell(row, `${String(birthday.day).padStart(2, '0')}/${String(birthday.month).padStart(2, '0')}`);
          addCell(row, birthday.emoji);
          addCell(row, birthday.role_name);
          addCell(row, birthday.ends_at ? 'Activo' : 'Registrado');
          rows.append(row);
        }
        const summary = birthdays.length ? `${birthdays.length} registros` : 'Sin registros';
        document.querySelector('#birthday-count').textContent = summary;
        message.textContent = birthdays.length ? '' : 'Todavía no hay cumpleaños registrados.';
        const overview = document.querySelector('#overview-birthdays');
        overview.textContent = birthdays.length ? `${birthdays.length} cumpleaños registrados en ${new Set(birthdays.map((item) => item.guild_id)).size} servidor(es).` : 'Todavía no hay cumpleaños registrados.';
      } catch (error) { message.textContent = error.message; message.classList.add('error'); }
    }
    async function loadGuilds() {
      const select = document.querySelector('#test-guild');
      const guilds = await api('/api/bot/guilds');
      select.replaceChildren(new Option('Selecciona un servidor', ''));
      for (const guild of guilds) select.add(new Option(`${guild.name} · ${guild.memberCount}`, guild.id));
      if (guilds.length === 1) { select.value = guilds[0].id; await loadActiveTests(); }
    }
    async function searchMembers() {
      const guildId = document.querySelector('#test-guild').value;
      const query = document.querySelector('#member-query').value.trim();
      const results = document.querySelector('#member-results');
      selectedMember = null;
      document.querySelector('#selected-member').textContent = 'Ningún usuario seleccionado';
      document.querySelector('#start-test').disabled = true;
      if (!guildId || query.length < 2) { results.replaceChildren(new Option('Elige servidor y escribe al menos dos caracteres', '')); return; }
      results.replaceChildren(new Option('Buscando…', ''));
      try {
        const members = await api(`/api/bot/guilds/${guildId}/members?q=${encodeURIComponent(query)}`);
        results.replaceChildren();
        if (!members.length) { results.add(new Option('No se encontraron miembros', '')); return; }
        window.memberResults = new Map(members.map((member) => [member.id, member]));
        for (const member of members) results.add(new Option(`${member.displayName}  ·  @${member.username}  ·  ${member.id}`, member.id));
      } catch (error) { results.replaceChildren(new Option(error.message, '')); }
    }
    document.querySelector('#member-query').addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(searchMembers, 300); });
    document.querySelector('#test-guild').addEventListener('change', () => { searchMembers(); loadActiveTests(); });
    document.querySelector('#member-results').addEventListener('change', (event) => {
      selectedMember = window.memberResults?.get(event.target.value) ?? null;
      const summary = document.querySelector('#selected-member');
      summary.replaceChildren();
      if (!selectedMember) { summary.textContent = 'Ningún usuario seleccionado'; document.querySelector('#start-test').disabled = true; return; }
      if (selectedMember.avatar) { const avatar = document.createElement('img'); avatar.src = selectedMember.avatar; avatar.alt = ''; avatar.className = 'member-avatar'; summary.append(avatar); }
      const name = document.createElement('span');
      name.textContent = `${selectedMember.displayName} · @${selectedMember.username} · ${selectedMember.id}`;
      summary.append(name);
      const saved = birthdayCache.find((birthday) => birthday.guild_id === document.querySelector('#test-guild').value && birthday.user_id === selectedMember.id);
      document.querySelector('#test-emoji').value = saved?.emoji ?? '🎂';
      document.querySelector('#test-role').value = saved?.role_name ?? `Cumpleañero ${selectedMember.displayName}`;
      document.querySelector('#start-test').disabled = false;
    });
    async function loadActiveTests() {
      const list = document.querySelector('#active-tests');
      try {
        const tests = await api('/api/bot/birthday-tests');
        const guildId = document.querySelector('#test-guild').value;
        const visible = tests.filter((test) => !guildId || test.guild_id === guildId);
        list.replaceChildren();
        if (!visible.length) { const empty = document.createElement('p'); empty.className = 'empty'; empty.textContent = 'No hay pruebas activas.'; list.append(empty); return; }
        for (const test of visible) {
          const row = document.createElement('div'); row.className = 'test-row';
          const info = document.createElement('div');
          const user = document.createElement('div'); user.className = 'test-user'; user.textContent = `${test.emoji} ${test.role_name}`;
          const detail = document.createElement('div'); detail.className = 'test-detail'; detail.textContent = `Usuario ${test.user_id} · termina ${new Date(test.ends_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}`;
          info.append(user, detail);
          const cancel = document.createElement('button'); cancel.className = 'button danger'; cancel.textContent = 'Cancelar y restaurar';
          cancel.addEventListener('click', async () => {
            cancel.disabled = true;
            try { await api(`/api/bot/guilds/${test.guild_id}/birthday-tests/${test.test_id}`, { method: 'DELETE' }); await loadActiveTests(); await loadBirthdays(); }
            catch (error) { cancel.disabled = false; document.querySelector('#test-message').textContent = error.message; document.querySelector('#test-message').classList.add('error'); }
          });
          row.append(info, cancel); list.append(row);
        }
      } catch (error) { list.textContent = error.message; }
    }
    document.querySelector('#start-test').addEventListener('click', async () => {
      const button = document.querySelector('#start-test');
      const message = document.querySelector('#test-message');
      button.disabled = true; message.textContent = 'Aplicando cambios temporales…'; message.className = 'message';
      try {
        await api('/api/bot/birthday-tests', { method: 'POST', body: JSON.stringify({
          guildId: document.querySelector('#test-guild').value,
          userId: selectedMember.id,
          emoji: document.querySelector('#test-emoji').value,
          roleName: document.querySelector('#test-role').value,
        }) });
        message.textContent = 'Prueba iniciada. Cancélala para restaurar los cambios al instante.'; message.classList.add('success');
        await loadActiveTests();
      } catch (error) { message.textContent = error.message; message.classList.add('error'); }
      finally { button.disabled = !selectedMember; }
    });
    document.querySelector('#refresh-birthdays').addEventListener('click', () => { loadBirthdays(); loadActiveTests(); });
    document.querySelector('#settings-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = document.querySelector('#save-button'); const message = document.querySelector('#save-message');
      button.disabled = true; message.textContent = 'Guardando…'; message.className = 'message';
      try {
        await api('/api/settings', { method: 'PUT', body: JSON.stringify({
          activityText: document.querySelector('#activity-text').value,
          activityType: document.querySelector('#activity-type').value,
          presenceStatus: document.querySelector('#presence-status').value,
        }) });
        message.textContent = 'Cambios guardados. Se aplicarán en unos segundos.'; message.classList.add('success');
      } catch (error) { message.textContent = error.message; message.classList.add('error'); }
      finally { button.disabled = false; }
    });
    document.querySelector('#logout').addEventListener('click', async () => { await fetch('/api/logout', { method: 'POST' }); location.href = '/login'; });
    refreshStatus(); loadSettings().catch((error) => { document.querySelector('#save-message').textContent = error.message; });
    loadBirthdays(); loadGuilds().catch((error) => { document.querySelector('#test-message').textContent = error.message; }); loadActiveTests();
    setInterval(refreshStatus, 15000);
  </script>
</body>
</html>
