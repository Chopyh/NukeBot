---
import '../styles/admin.css';
import '../styles/globals.css';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import PageHeading from '../components/PageHeading.astro';
import BirthdayTable from '../components/BirthdayTable.astro';
import BirthdayTestPanel from '../components/BirthdayTestPanel.jsx';
---
<!doctype html>
<html lang="es" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Administración · Nuke Bot</title>
</head>
<body>
  <div class="layout">
    <Sidebar />

    <div class="main">
      <Topbar />
      <main class="content">
        <section id="page-overview" class="page active">
          <PageHeading title="Resumen" description="Estado del bot y actividad del servidor." />
          <div class="stats" aria-live="polite">
            <div class="stat"><div class="stat-label">Conexión</div><div id="status" class="stat-value">Comprobando</div><div id="bot-name" class="stat-detail">Esperando al bot</div></div>
            <div class="stat"><div class="stat-label">Servidores de Discord</div><div id="guilds" class="stat-value">—</div><div class="stat-detail">Servidores conectados</div></div>
            <div class="stat"><div class="stat-label">Tiempo activo</div><div id="uptime" class="stat-value">—</div><div class="stat-detail">Desde el último inicio</div></div>
          </div>
          <section class="section"><div class="section-head"><div><h2 class="section-title">Cumpleaños registrados</h2><p class="section-note">Vista rápida de los registros guardados.</p></div><button class="button" data-open-page="birthdays">Ver todos</button></div><div id="overview-birthdays" class="empty">Cargando registros…</div></section>
          <footer>Panel privado · Actualización del estado cada 15 segundos</footer>
        </section>

        <section id="page-birthdays" class="page">
          <PageHeading title="Cumpleaños" description="Registros y pruebas temporales de la decoración y el rol."><button id="refresh-birthdays" class="button">Actualizar</button></PageHeading>
          <BirthdayTable />

          <BirthdayTestPanel client:load />
        </section>

        <section id="page-settings" class="page">
          <PageHeading title="Configuración" description="Presencia y actividad que muestra el bot en Discord." />
          <form id="settings-form" class="settings-form">
            <label class="field">Texto de actividad <input id="activity-text" maxlength="128" placeholder="Ej. gestionando la comunidad"></label>
            <label class="field">Tipo de actividad<select id="activity-type"><option value="playing">Jugando a</option><option value="listening">Escuchando</option><option value="watching">Viendo</option><option value="competing">Compitiendo en</option></select></label>
            <label class="field">Estado de presencia<select id="presence-status"><option value="online">En línea</option><option value="idle">Ausente</option><option value="dnd">No molestar</option><option value="invisible">Invisible</option></select></label>
            <button id="save-button" class="button primary" type="submit">Guardar cambios</button><p id="save-message" class="message" role="status"></p>
          </form>
        </section>
      </main>
    </div>
  </div>

  <script src="../scripts/admin.js"></script>
</body>
</html>
