---
import '../styles/admin.css';
import '../styles/globals.css';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import PageHeading from '../components/PageHeading.astro';
import BirthdayTable from '../components/BirthdayTable.astro';
import BirthdayTestPanel from '../components/BirthdayTestPanel';
import ReactionRolesPanel from '../components/ReactionRolesPanel.astro';
---
<!doctype html>
<html lang="es" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Administración · Nuke Bot</title>
</head>
<body>
  <div class="layout">
    <Sidebar />

    <div class="main">
      <Topbar />
      <main class="content">
        <section id="page-overview" class="page active">
          <PageHeading title="Resumen" description="Estado del bot y actividad del servidor." />
          <div class="stats" aria-live="polite">
            <div class="stat"><div class="stat-label">Conexión</div><div id="status" class="stat-value">Comprobando</div><div id="bot-name" class="stat-detail">Esperando al bot</div></div>
            <div class="stat"><div class="stat-label">Servidores de Discord</div><div id="guilds" class="stat-value">—</div><div class="stat-detail">Servidores conectados</div></div>
            <div class="stat"><div class="stat-label">Tiempo activo</div><div id="uptime" class="stat-value">—</div><div class="stat-detail">Desde el último inicio</div></div>
          </div>
          <section class="section"><div class="section-head"><div><h2 class="section-title">Cumpleaños registrados</h2><p class="section-note">Vista rápida de los registros guardados.</p></div><button class="button" data-open-page="birthdays">Ver todos</button></div><div id="overview-birthdays" class="empty">Cargando registros…</div></section>
          <footer>Panel privado · Actualización del estado cada 15 segundos</footer>
        </section>

        <section id="page-birthdays" class="page">
          <PageHeading title="Cumpleaños" description="Registros y pruebas temporales de la decoración y el rol."><button id="refresh-birthdays" class="button">Actualizar</button></PageHeading>
          <BirthdayTable />

          <BirthdayTestPanel client:load />
        </section>

        <section id="page-reaction-roles" class="page">
          <PageHeading title="Roles por reacción" description="Asigna roles a miembros desde reacciones en mensajes de Discord." />
          <ReactionRolesPanel />
        </section>

        <section id="page-game-roles" class="page">
          <PageHeading title="Roles de juegos" description="Gestiona opciones de juegos y sus roles desde un mensaje persistente de Discord." />
          <section class="section game-roles-panel">
            <div class="game-role-fields">
              <label class="field">Servidor<select id="game-role-guild" required><option value="">Cargando servidores…</option></select></label>
              <label class="field">Canal del mensaje<select id="game-role-channel" required disabled><option value="">Selecciona un servidor</option></select></label>
              <label class="field">Categoría para canales creados automáticamente<select id="game-role-category" disabled><option value="">Sin categoría</option></select></label>
              <label class="field">Texto inicial<textarea id="game-role-intro" maxlength="1500" rows="3" placeholder="Elige los juegos que juegas:"></textarea></label>
              <div class="game-role-list-head"><div><h2 class="section-title">Juegos</h2><p class="section-note">Cada juego crea y administra su propio rol.</p></div><button id="game-role-add" class="button" type="button">＋ Añadir juego</button></div>
              <div id="game-role-games" class="game-role-games"></div>
              <label class="field">Texto final<textarea id="game-role-outro" maxlength="1500" rows="3" placeholder="Puedes cambiar tu selección cuando quieras."></textarea></label>
              <div class="game-role-save"><button id="game-role-save" class="button primary" type="button">Guardar y actualizar mensaje</button><p id="game-role-message" class="message" role="status" aria-live="polite"></p></div>
              <p id="game-role-persistent" class="field-hint">El mensaje se crea al guardar por primera vez y conserva su ID al actualizar juegos y textos.</p>
            </div>
          </section>
        </section>

        <section id="page-settings" class="page">
          <PageHeading title="Configuración" description="Presencia y actividad que muestra el bot en Discord." />
          <form id="settings-form" class="settings-form">
            <label class="field">Texto de actividad <input id="activity-text" maxlength="128" placeholder="Ej. gestionando la comunidad"></label>
            <label class="field">Tipo de actividad<select id="activity-type"><option value="playing">Jugando a</option><option value="listening">Escuchando</option><option value="watching">Viendo</option><option value="competing">Compitiendo en</option></select></label>
            <label class="field">Estado de presencia<select id="presence-status"><option value="online">En línea</option><option value="idle">Ausente</option><option value="dnd">No molestar</option><option value="invisible">Invisible</option></select></label>
            <button id="save-button" class="button primary" type="submit">Guardar cambios</button><p id="save-message" class="message" role="status"></p>
          </form>
        </section>
      </main>
    </div>
  </div>

  <script src="../scripts/admin.ts"></script>
</body>
</html>
