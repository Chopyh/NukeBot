---
import '../styles/login.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Acceso · Nuke Bot</title>

</head>
<body>
  <main class="login">
    <div class="brand"><div class="brand-mark">N</div><div>NUKE BOT<small>ADMINISTRACIÓN</small></div></div>
    <h1>Iniciar sesión</h1>
    <p class="intro">Accede con tu cuenta de Discord. El panel está disponible para quienes tengan el rol <strong>Dios</strong> en el servidor principal.</p>
    <a class="discord-login" href="/auth/discord"><span class="discord-icon" aria-hidden="true">◉</span>Continuar con Discord</a>
    <p id="login-message" role="status" aria-live="polite"></p>
    <footer>Acceso privado · Nuke Bot</footer>
  </main>
  <script src="../scripts/login.js"></script>
</body>
</html>
