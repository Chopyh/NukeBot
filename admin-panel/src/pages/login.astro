<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Acceso · Nuke Bot</title>
  <style>
    :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #e8e8e9; background: #101113; font-synthesis: none; --line: #292a2d; --muted: #85868b; --accent: #d3ff75; }
    * { box-sizing: border-box; }
    body { display: grid; min-height: 100vh; margin: 0; place-items: center; background: #101113; }
    .login { width: min(calc(100% - 32px), 360px); }
    .brand { display: flex; align-items: center; gap: 11px; margin-bottom: 36px; color: #f0f0f0; font-size: 13px; font-weight: 750; letter-spacing: .09em; }
    .brand-mark { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid #44464a; border-radius: 8px; color: var(--accent); font-weight: 800; }
    .brand small { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; font-weight: 500; letter-spacing: .04em; }
    h1 { margin: 0; color: #f0f0f1; font-size: 23px; font-weight: 620; letter-spacing: -.035em; }
    .intro { margin: 8px 0 27px; color: var(--muted); font-size: 12px; line-height: 1.6; }
    form { padding-top: 22px; border-top: 1px solid var(--line); }
    label { display: grid; gap: 8px; margin-bottom: 17px; color: #a5a6aa; font-size: 11px; }
    input { width: 100%; height: 40px; padding: 0 11px; border: 1px solid #35363a; border-radius: 5px; outline: none; color: #e6e6e7; background: #111214; font: inherit; font-size: 12px; }
    input:focus { border-color: #919b72; }
    button { width: 100%; height: 39px; margin-top: 2px; border: 1px solid var(--accent); border-radius: 5px; color: #171a10; background: var(--accent); font: inherit; font-size: 11px; font-weight: 700; cursor: pointer; }
    button:disabled { cursor: wait; opacity: .55; }
    #login-message { min-height: 18px; margin-top: 12px; color: #ee9b9d; font-size: 11px; }
    footer { margin-top: 35px; color: #626368; font-size: 10px; }
  </style>
</head>
<body>
  <main class="login">
    <div class="brand"><div class="brand-mark">N</div><div>NUKE BOT<small>ADMINISTRACIÓN</small></div></div>
    <h1>Iniciar sesión</h1>
    <p class="intro">Introduce tus credenciales de administrador para acceder al panel.</p>
    <form id="login-form">
      <label>Usuario<input id="username" name="username" autocomplete="username" required autofocus></label>
      <label>Contraseña<input id="password" name="password" type="password" autocomplete="current-password" required></label>
      <button id="login-button" type="submit">Entrar al panel</button>
      <div id="login-message" role="status"></div>
    </form>
    <footer>Acceso privado · Nuke Bot</footer>
  </main>
  <script>
    document.querySelector('#login-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = document.querySelector('#login-button');
      const message = document.querySelector('#login-message');
      button.disabled = true;
      message.textContent = '';
      try {
        const response = await fetch('/api/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            username: document.querySelector('#username').value,
            password: document.querySelector('#password').value,
          }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error ?? 'No se pudo iniciar sesión.');
        location.href = '/';
      } catch (error) {
        message.textContent = error.message;
        button.disabled = false;
      }
    });
  </script>
</body>
</html>
